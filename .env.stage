# .env.stage
# Staging-only environment for GO-SAAS Flutter app (M2A isolated local staging).
#
# The Flutter app loads `.env` via flutter_dotenv with fileName: '.env' in
# lib/main.dart. It does NOT auto-load .env.stage. To use this configuration,
# copy this file to .env (or set API_BASE_URL via your build environment) when
# running against the isolated staging backend, then restore the original .env
# afterwards. Do NOT modify the existing .env file.
#
# API_BASE_URL=http://127.0.0.1:18080  (staging backend, loopback only)

API_BASE_URL=http://127.0.0.1:18080
